# Generated output. The page is produced by tools/generate.py from the other
# repositories, so committing it would create a second copy that can disagree
# with the projects it describes -- the exact drift this design avoids.
.site/
.tmp/
__pycache__/

# Intermediate WOFF2. Only the .base64 forms are committed, because those are
# what the generator embeds; keeping both invites one being edited without the
# other.
faces/*.woff2
